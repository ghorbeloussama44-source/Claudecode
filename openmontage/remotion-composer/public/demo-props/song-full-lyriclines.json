{
  "lyrics": [
    {
      "text": "كان يسيرُ وحيدًا تحتَ الأضواءِ",
      "inSeconds": 0.1,
      "outSeconds": 2.86
    },
    {
      "text": "عالمٌ من شهرةٍ، لكنْ مليءٌ بالبلاءِ",
      "inSeconds": 2.94,
      "outSeconds": 5.58
    },
    {
      "text": "خلفَ الابتسامةِ قلبٌ جريحٌ",
      "inSeconds": 5.62,
      "outSeconds": 7.5
    },
    {
      "text": "يقاومُ العواصفَ ويرقصُ في الريحِ",
      "inSeconds": 7.68,
      "outSeconds": 11.02
    },
    {
      "text": "كلُّ ندبةٍ تخفي حكايةً أليمةْ",
      "inSeconds": 13.42,
      "outSeconds": 22.39
    },
    {
      "text": "صرخةٌ صامتةٌ وسطَ الظلمةِ العظيمةْ",
      "inSeconds": 22.44,
      "outSeconds": 24.98
    },
    {
      "text": "لكنْ في الظلامِ شعلةُ النورِ تجلَّتْ",
      "inSeconds": 25.02,
      "outSeconds": 27.32
    },
    {
      "text": "صوتٌ في داخلهِ أعلى من كلِّ ما هلَّتْ",
      "inSeconds": 27.36,
      "outSeconds": 44.68
    },
    {
      "text": "لا تستسلمْ أبدًا مهما كانَ الصراعْ",
      "inSeconds": 44.76,
      "outSeconds": 49.02
    },
    {
      "text": "في قلبِ الظلالِ سأجدُ الضياءَ والشراعْ",
      "inSeconds": 49.3,
      "outSeconds": 53.64
    },
    {
      "text": "أحلامٌ تكسَّرتْ لكني سأبقى قويًا",
      "inSeconds": 54.24,
      "outSeconds": 58.54
    },
    {
      "text": "الحريةُ تناديني، وسأعبرُ كلَّ شيءٍ نقيًا",
      "inSeconds": 58.76,
      "outSeconds": 64.08
    },
    {
      "text": "تصفيقُ الجموعِ كانَ يثقلُ خطاهُ",
      "inSeconds": 69.02,
      "outSeconds": 71.48
    },
    {
      "text": "سلاسلُ الذهبِ لم تغيِّرْ درباهُ",
      "inSeconds": 71.66,
      "outSeconds": 74.1
    },
    {
      "text": "حياةٌ هشَّةٌ والحبُّ فيها نادرْ",
      "inSeconds": 74.16,
      "outSeconds": 76.54
    },
    {
      "text": "لكنَّ حنانَهُ أصبحَ منارةً في العابرْ",
      "inSeconds": 76.58,
      "outSeconds": 79.16
    },
    {
      "text": "كلُّ سقوطٍ زادَهُ قوةً وإصرارًا",
      "inSeconds": 79.4,
      "outSeconds": 81.84
    },
    {
      "text": "شعلةٌ في القلبِ تزيدُهُ استنارةً",
      "inSeconds": 81.92,
      "outSeconds": 84.26
    },
    {
      "text": "طريقٌ حفرَهُ بعزمٍ وجهدٍ عميقْ",
      "inSeconds": 84.3,
      "outSeconds": 87.1
    },
    {
      "text": "إرثٌ خالدٌ يبقى شاهدًا للأجيالِ الصديقْ",
      "inSeconds": 87.11,
      "outSeconds": 90.34
    },
    {
      "text": "لا تستسلمْ أبدًا مهما كانَ الصراعْ",
      "inSeconds": 90.36,
      "outSeconds": 94.78
    },
    {
      "text": "في قلبِ الظلالِ سأجدُ الضياءَ والشراعْ",
      "inSeconds": 94.84,
      "outSeconds": 99.76
    },
    {
      "text": "أحلامٌ تكسَّرتْ لكني سأبقى قويًا",
      "inSeconds": 100.1,
      "outSeconds": 103.98
    },
    {
      "text": "الحريةُ تناديني، وسأعبرُ كلَّ شيءٍ نقيًا",
      "inSeconds": 104.16,
      "outSeconds": 109.46
    },
    {
      "text": "حاولوا كسرَهُ لكنه كانَ كالجبالْ",
      "inSeconds": 119.46,
      "outSeconds": 122.5
    },
    {
      "text": "في كلِّ خسارةٍ وجدَ درسًا واحتمالْ",
      "inSeconds": 124.38,
      "outSeconds": 127.46
    },
    {
      "text": "الطريقُ طويلٌ لكنَّ قلبَهُ حرُّ",
      "inSeconds": 129.28,
      "outSeconds": 133.02
    },
    {
      "text": "يتبعُ الحقيقةَ كالنهرِ لا يفرُّ",
      "inSeconds": 134.22,
      "outSeconds": 137.46
    },
    {
      "text": "لا تستسلمْ أبدًا مهما كانَ الصراعْ",
      "inSeconds": 139.18,
      "outSeconds": 143.32
    },
    {
      "text": "في قلبِ الظلالِ سأجدُ الضياءَ والشراعْ",
      "inSeconds": 144.08,
      "outSeconds": 148.98
    },
    {
      "text": "أحلامٌ تكسَّرتْ لكني سأبقى قويًا",
      "inSeconds": 149.06,
      "outSeconds": 153.56
    },
    {
      "text": "الحريةُ تناديني، وسأعبرُ كلَّ شيءٍ نقيًا",
      "inSeconds": 153.68,
      "outSeconds": 158.46
    },
    {
      "text": "لا تستسلمْ أبدًا، هذا كانَ شعارَهْ",
      "inSeconds": 158.54,
      "outSeconds": 163.36
    },
    {
      "text": "وسطَ الصراعِ أبقى الأملَ في مسارِهْ",
      "inSeconds": 163.78,
      "outSeconds": 167.18
    },
    {
      "text": "الرجلُ الذي صمدَ رغمَ اللهبِ",
      "inSeconds": 168.68,
      "outSeconds": 172.4
    },
    {
      "text": "قصةُ أملٍ وقوةٍ لكلِّ قلبٍ حيٍّ في دربِ",
      "inSeconds": 173.34,
      "outSeconds": 178.22
    }
  ],
